# 4906 المغيرة بن الضحاك بن عبد الله القرشي الأسدي المدني الحزامي عن أم
~~حكيم بنت اسيد وعنه بكير بن الأشج وثقه بن حبان
# 4907 المغيرة بن عبد الرحمن بن عبد الله بن خالد بن حزام الحزامي المدني
~~لقبه قصي عن أبي الزناد فأكثر وعنه يحيى بن يحيى وقتيبة
# 4908 المغيرة بن عبد الرحمن بن الحارث ms2588 بن عبد الله بن عياش بن أبي ربيعة
~~المخزومي أبو هاشم أو هشام المدني الفقيه عن هشام بن عروة وابن عجلان وعنه
~~أبو عبيدة عبدة الضبي ومحمد بن مسلمة المخزومي PageV07P395
# 4909 المغيرة بن عبيد الله بن جبير بن حية الثقفي عن عمه زياد وعنه أبو
~~عبيدة الحداد وثقه بن حبان
# 4910 المغيرة بن أبي قرة السدوسي عن أنس وعنه يحيى القطان وثقه بن حبان
# 4911 مغيرة بن مقسم الضبي مولاهم أبو هشام الكوفي الأعمى الفقيه عن
~~إبراهيم النخعي والشعبي وطائفة وعنه شعبة والثوري وزائدة وخلق
# 4912 مغيرة الأزدي عن محمد بن زيد وعنه أبو حمزة السكري لعله القسملي
# 4913 المغيرة بن مسلم القسملي أبو سلمة السراج المدائني عن بن بريدة
~~وعمرو بن دينار وعنه شبابة وعلي بن عاصم قال أبو حاتم صدوق
# 4914 مفضل بن صالح الأسدي النخاس الكوفي أبو جميلة عن زياد بن علاقة وعنه
~~محمد بن عبيد المحاربي
# 4915 المفضل بن عبد الله الكوفي عن أبي إسحاق وعنه سويد بن سعيد وثقه بن
~~حبان وضعفه أبو حاتم
# 4916 المفضل بن عبد الله اليربوعي البصري سكن بغداد عن داود بن أبي هند
~~روى عنه أبو معمر القطيعي قال أبو حاتم محله الصدق
# 4917 المفضل بن فضالة بن أبي أمية أبو مالك القرشي مولاهم البصري أخو
~~مبارك عن ثابت وجماعة وعنه بن مهدي وحجاج الأعور وثقه بن حبان
# 4918 المفضل بن فضالة بن عبيد بن ثمامة القتباني الرعيني المصري أبو
~~معاوية قاضي مصر عن عياش بن عباس وعقيل بن خالد الأيلي وعنه الوليد بن مسلم
~~وقتيبة قال بن يونس ثقه وكذا قال بن معين PageV07P396
# | 1 ( من اسمه مقاتل ومقسم )
# 4919 مقاتل بن بشير العجلي الكوفي عن شريح بن هانئ وعنه مالك بن مغول
~~وثقه بن حبان
# 4920 مقاتل بن حيان البكري مولاهم النبطي أبو بسطام البلخي الخراز عن
~~مجاهد وعروة وسالم وعنه إبراهيم بن أدهم وابن المبارك وثقه بن معين
# 4921 مقاتل بن سليمان بن بشير البجلي الأزدي الخراساني أبو ms2589 الحسن البلخي
~~نزيل مرو ويقال له بن دوال دوز البصري المفسر عن مجاهد والضحاك وعنه علي بن
~~الجعد وابن عيينة اجمعوا على تضعيفه
# 4922 مقسم بن مولى بن عباس عن عائشة وأم سلمة رضي الله عنهما وعنه ميمون
~~بن مهران والحكم بن عتيبة وطائفة قال أبو حاتم لا بأس به
# | 1 ( من اسمه مكتوم ومكحول وملازم )
# 4923 مكتوم بن العباس أبو الفضل المروزي ويقال الترمذي عن محمد بن يوسف
~~الفريابي وعنه الترمذي وغيره
# 4924 مكحول الدمشقي أبو عبد الله الشامي عن كثير من الصحابة مرسلا عن
~~واثلة وأنس رضي الله عنهما وخلق وعنه أيوب بن موسى وزيد بن واقد والأوزاعي
~~وخلق PageV07P397
# 4925 ملازم بن عمرو بن عبد الله بن بدر أبو عمرو اليمامي السحيمي عن عبد
~~الله بن بدر وعنه هناد وأحمد بن المقدام وثقه بن معين والنسائي وأبو زرعة
# | 1 ( من اسمه مندل والمنذر )
# 4926 مندل بن علي العنزي أبو عبد الله الكوفي ويقال اسمه عمرو ومندل لقب
~~عن مغيرة وابن جريج وعنه أبو نعيم وزيد بن الحباب
# 4927 المنذر بن مالك بن قطعة أبو نضرة العبدي العوقي البصري عن علي وأبي
~~ذر مرسلا وابن عباس رضي الله عنهم وعنه قتادة وعبد العزيز بن صهيب وجماعة
~~وثقه بن معين والنسائي وأبو زرعة وابن سعد
# 4928 المنذر بن المغيرة المدني عن عروة وعنه بكير بن الأشج
# 4929 المنذر بن أبي المنذر عن بعض التابعين فيه جهالة قلت روى عنه بن أبي
~~ذئب وعبد الرحمن بن إسحاق المدني رواية عن بن عباس ذكره بن حبان في الثقات
# | 1 ( من اسمه منصور )
# 4930 منصور بن أبي الأسود الليثي الكوفي يقال اسم أبيه حازم عن حصين بن
~~عبد الرحمن وعنه بن مهدي وأبو نعيم وثقه بن معين PageV07P398
# 4931 منصور بن سعيد أو بن زيد بن الاصبغ الكلبي المصري عن دحية وعنه أبو
~~الخير اليزني وثقه العجلي قال بن المديني مجهول
# 4932 منصور بن سلمة الهذلي ويقال الليثي المدني عن حكيم بن محمد بن ms2590 قيس
~~بن مخرمة وعنه زيد بن الحباب لا يكاد يعرف وثقه بن حبان
# 4933 منصور صقير أبو النضر البغدادي عن حماد بن سلمة وعنه عباس الدوري
# 4934 منصور بن عبد الرحمن التميمي الغداني النضري الأشل عن الشعبي وعنه
~~شعبة وابن علية وثقه بن معين
# 4935 منصور بن عبد الرحمن بن طلحة بن الحارث بن طلحة بن أبي طلحة العبدري
~~الحجبي المكي وهو بن صفية بنت شيبة عن أمه صفية وسعيد بن جبير وعنه
~~السفيانان ووهيب بن خالد وطائفة وثقه النسائي والناس
# 4936 منصور بن عبد الرحمن البرجمي عن أبي مجلز وعنه وكيع لا يعرف وثقه بن
~~حبان
# 4937 منصور بن النعمان اليشكري أبو حفص البصري سكن مرو ثم بخارى سمع عبد
~~الله بن يزيد عن أبي مجلز وعنه بن المبارك غنجار قال السليماني فيه نظر
~~ووثقه بن حبان
# 4938 منصور بن وردان الأسدي أبو عبد الله الكوفي العطار عن أبان بن تغلب
~~وفطر بن خليفة وعنه بن نمير وأحمد ووثقه
# 4939 منظور بن سيار البصري عن بهيسة وعنه ابنه سيار وثقه بن حبان
~~PageV07P399
# | 1 ( من اسمه المنكدر والمنهال )
# 4940 المنكدر بن محمد بن المنكدر القرشي التيمي المدني عن بن شهاب وعنه
~~بن وهب وقتيبة لين الحديث وثقه أحمد
# 4941 المنهال بن خليفة العجلي أبو قدامة الكوفي عن عطاء وعنه بن المبارك
~~ويحيى بن يمان ضعفه بن معين
# 4942 المنهال بن عمرو الأسدي مولاهم الكوفي عن بن الحنفية وزر بن حبيش
~~وعنه زيد بن أبي أنيسة ومنصور والأعمش صدوق ربما وهم
# | 1 ( من اسمه منيب ومنير ومهاجر )
# 4943 منيب بن عبد الله بن أبي امامة بن ثعلبة الأنصاري الحارثي المدني عن
~~أبيه وعنه ابنه عبد الله وثقه بن حبان
# 4944 منير بن الزبير الشامي أبو ذر الأزدي عن مكحول وعنه الوليد بن مسلم
~~ضعفه دحيم
# 4945 مهاجر بن مخلد أبو مخلد مولى البكرات عن أبي العالية وعنه حماد بن
~~زيد وثقه بن حبان ولينه أبو حاتم
# | 1 ( من اسمه مهدي ومهلب ms2591 ومهنا )
# 4946 مهدي بن حفص أو جعفر البغدادي أبو أحمد عن حماد بن زيد وغيره وعنه
~~أبو زرعة وأبو داود وطائفة قال بن معين لا بأس به وقال البخاري منكر الحديث
~~PageV07P400
# 4947 مهدي بن حرب العبدي وهو بن أبي مهدي الهجري عن عكرمة وعنه حوشب بن
~~عقيل
# 4948 مهدي بن عبد الرحمن عن عمته أم الدرداء وعنه عاصم بن رجاء
# 4949 مهران بن أبي عمير الرازي أبو عبد الله العطار عن إسماعيل بن أبي
~~خالد وعنه محمد بن حميد ومحمد بن عمر وزنيج ووثقه بن حبان وأبو حاتم
# 4950 مهران أبو صفوان كوفي عن بن عباس وعنه الحسن بن عمرو الفقيمي وثقه
~~بن حبان قال أبو زرعة لا اعرفه
# 4951 مهلب بن حجر البهراني الشامي عن ضباعة بنت المقداد وعنه الوليد بن
~~كامل وثقه بن حبان
# 4952 المهلب بن أبي حبيبة البصري عن بن أبي الشعثاء وعنه بن أبي عروبة
~~وثقه أبو داود وأحمد
# 4953 مهنأ بن عبد الحميد أبو شبل ويقال أبو سهل البصري عن حماد بن سلمة
~~وعنه أحمد وثقه أبو داود وغيره
# | 1 ( من اسمه موسى )
# 4954 موسى بن إبراهيم بن عبد الرحمن بن عبد الله بن أبي ربيعة المخزومي
~~عن أبيه وسلمة بن الأكوع وعنه العطاف بن خالد وغيره وثقه بن حبان
~~PageV07P401
# 4955 موسى بن إسماعيل التيمي المنقري أبو سلمة التبوذكي البصري الحافظ عن
~~شعبة فرد حديث وحماد بن سلمة واعين الخوارزمي وخلق وعنه البخاري وأبو داود
~~وأبو زرعة ومحمد بن يحيى وابن معين وقال وثقه مأمون
# 4956 موسى بن أيوب بن عامر الغافقي العاملي البصري عن عمه إياس بن عامر
~~وعنه الليث وابن المبارك وثقه بن معين وأبو داود
# 4957 موسى بن باذان ويقال اسمه مسلم الحجازي عن علي رضي الله عنه وعنه
~~عمارة بن ثوبان مجهول
# 4958 موسى بن جعفر بن محمد بن علي بن الحسين بن علي بن أبي طالب الهاشمي
~~أبو الحسن الملقب بالكاظم المدني عن أبيه وعنه ابنه علي الرضا وأخواه ms2592 علي
~~ومحمد ابنا جعفر بن محمد وطائفة قال أبو حاتم ثقة صدوق امام من أئمة
~~المسلمين مات سنة ثلاث وثمانين ومائة رحمه الله
# 4959 موسى بن خلف العمى أبو خلف البصري عن قتادة وحماد بن أبي سليمان
~~وعنه ابناه عبد الحميد وخلف وجماعة
# 4960 موسى بن داود الضبي أبو عبد الله الخلقاني بضم المعجمة وسكون اللام
~~بعدها قاف الطرسوسي نزيل بغداد ولي قضاء طرسوس فقيه زاهد
# 4961 موسى بن دهقان البصري مدني كوفي الأصل عن أبي سعيد الخدري وعنه
~~عثمان بن فارس ووكيع قال بن معين ليس بشيء PageV07P402
# 4962 موسى بن زياد بن حذيم بن عمرو السعدي عن أبيه وعن جده وعنه مغيرة بن
~~مقسم وثقه بن حبان
# 4963 موسى بن سلمة بن أبي مريم المصري مولى بني جمح عن هشام بن عروة وعنه
~~أخيه سعيد بن أبي مريم وثقه بن حبان
# 4964 موسى بن شيبة الحضرمي المصري عن الأوزاعي وعنه بن وهب فقط
# 4965 موسى بن طارق اليماني أبو قرة الزبيدي القاضي صاحب السنن عن موسى بن
~~عقبة وابن جريج وطائفة وعنه أحمد وأبو حمة الزبيدي
# 4966 موسى بن عامر بن عمارة بن خريم الناعم البري أبو عامر بن الأمير أبي
~~الهيدام الدمشقي المزني الدمشقي عن بن عيينة وأنس بن عياض وعنه أبو داود
~~حديثا أو حديثين صدوق وله أوهام وثقه بن حبان
# 4967 موسى بن عبد الله ويقال بن عبد الرحمن الجهني أبو سلمة الكوفي ثقة
~~عابد عن الشعبي وزيد بن وهب وجماعة وعنه الثوري ويحيى بن أبي زائدة وطائفة
~~وثقه أحمد وغيره
# 4968 موسى بن عبد الله بن أبي أمية المخزومي عن أخيه مصعب وعنه محمد بن
~~إبراهيم السهمي مجهول
# 4969 موسى بن عبد العزيز العدني أبو شعيب القنباري عن الحكم بن أبان وعنه
~~بشر بن الحكم وابنه عبد الرحمن بن بشر وزيد بن المبارك ووثقه بن حبان
~~PageV07P403
# 4970 موسى بن عبيدة بن نشيط الربذي أبو عبد العزيز المدني العدوي مولاهم
~~أبو محمد عن محمد بن كعب ms2593 ونافع وجماعة وعنه شعبة وابن المبارك وطائفة
# 4971 موسى بن أبي علقمة الفروي مولى آل عثمان المدني عن هشام بن سعد وعنه
~~ابنه هارون مجهول
# 4972 موسى بن عمرو بن سعيد بن العاصي الأموي المكي أخو سعيد والد أيوب
~~الأشدق عن أبيه وعنه ابنه أيوب وثقه بن حبان
# 4973 موسى بن عمير الأنصاري عن أبيه وعنه أبو الجحاف داود بن أبي عوف
~~سويد
# 4974 موسى بن عمير القرشي مولاهم أبو هارون الكوفي الأعمى عن الشعبي وقد
~~كذبه أبو حاتم
# 4974 موسى بن عمير التميمي العنبري الكوفي عن الشعبي وعنه حفص بن غياث
~~وابن المبارك وثقه بن معين وأبو حاتم والخطيب
# 4975 موسى بن قيس الحضرمي أبو محمد الفراء الكوفي يلقب عصفور الجنة عن
~~سلمة بن كهيل وعنه أبو نعيم وثقه بن معين
# 4976 موسى بن أبي كثير الأنصاري مولاهم أبو الصباح ويقال له موسى الكبير
~~عن أبي المسيب وعنه مسعر وشريك
# 4977 موسى بن كردم كوفي عن محمد بن قيس وعنه نصر بن حماد مجهول
# 4978 موسى بن محمد بن إبراهيم بن الحارث التيمي أبو محمد المدني عن أبيه
~~وعنه الدراوردي ضعفه بن معين PageV07P404
# 4979 موسى بن مسعود النهدي أبو حذيفة البصري عن الثوري وزائدة وطائفة
~~وعنه البخاري والحسن بن عرفة وطائفة قال العجلي ثقة صدوق
# 4980 موسى بن مسلم بن رومان ويقال صالح بن مسلم وهو الصواب عن أبي الزبير
~~وعنه يزيد بن هارون
# 4981 موسى بن مسلم بن أبي مسلم مولى ابنه قارظ عن أبي هريرة وعنه أسامة
~~الليثي لا يعرف وثقه بن حبان
# 4982 موسى بن المسيب أو السائب أبو جعفر الثقفي البزاز الكوفي عن شهر بن
~~حوشب وعنه عمر بن علي المقدمي ويعلى بن عبيد
# 4983 موسى بن نافع الأسدي ويقال الهذلي أبو شهاب الحناط مشهور بكنيته وهو
~~الأكبر عن سعيد بن جبير وعطاء وجماعة وعنه عيسى بن يونس وأبو نعيم وطائفة
~~وثقه بن معين
# 4984 موسى بن نجدة الحنفي اليمامي السحيمي عن جده وعنه ملازم ms2594 بن عمرو
~~مجهول
# 4985 موسى بن وردان العامري مولاهم أبو عمر المصري القاضي مدني الأصل عن
~~أبي هريرة وأبي سعيد وجماعة وعنه حيوة بن شريح والليث وطائفة وثقه العجلي
~~صدوق ربما أخطأ
# 4986 موسى بن يعقوب بن عبد الله بن وهب بن زمعة بن الأسود الأسدي الزمعي
~~أبو محمد المدني عن أبي حازم وهاشم بن القاسم وجماعة وعنه بن مهدي وخالد بن
~~مخلد وطائفة وثقه بن معين في رواية عباس
# | 1 ( من اسمه مؤمل وميسرة )
# PageV07P405
# 4987 مؤمل بن إسماعيل العدوي مولاهم البصري أبو عبد الرحمن نزيل مكة عن
~~شعبة والثوري وجماعة وعنه أحمد وإسحاق وابن المديني وطائفة وثقه بن معين
~~وقال البخاري منكر الحديث
# 4988 مؤمل بن اهاب بن عبد العزيز الربعي ثم العجلي أبو عبد الرحمن الكوفي
~~نزيل الرملة أصله من كرمان عن ضمرة وأيوب بن سويد وطائفة وعنه أبو داود
~~والنسائي
# 4989 مؤمل بن الفضل الحراني أبو سعيد عن عيسى بن يونس وعتاب بن بشير
~~وجماعة وعنه أبو داود قال أبو حاتم ثقة رضى
# 4990 ميسرة عن مولاه فضالة بن عبيد وعنه إسماعيل بن عبيد بن أبي المهاجر
# | 1 ( من اسمه ميمون وميناء )
# 4991 ميمون بن جابان البصري أبو الحكم عن أبي رافع وعنه الحمادان وثقه بن
~~حبان
# 4992 ميمون بن سياه البصري أبو بحر عن أنس وغيره وعنه حميد الطويل وحزم
~~القطيعي وطائفة وثقه أبو حاتم وابن حبان وضعفه بن معين
# 4993 ميمون بن أبي شبيب الربعي أبو نصر الكوفي عن علي ومغيرة بن شعبة
~~وعنه الحكم وحبيب بن أبي ثابت وثقه بن حبان قتل في الجماجم
# 4994 ميمون بن العباس الجزري الرافقي أبو منصور عن عبيد الله بن موسى
~~وأحمد بن خالد الوهبي وطائفة وعنه النسائي ووثقه
# 4995 ميمون بن عبد الله عن ثابت وعنه زيد بن الحباب مجهول ولعله بن أبان
~~PageV07P406
# 4996 ميمون بن موسى المرئي ويقال بن عبد الرحمن بن صفوان بن قدامة أبو
~~موسى البصري عن الحسن وعنه حماد بن سلمة وأبو الوليد ms2595 الطيالسي
# 4997 ميمون أبو حمزة الأعور القصاب عن بن المسيب والشعبي وعنه الحمادان
# 4998 ميمون الكردي أبو بصير عن أبي عثمان النهدي وعنه حماد بن زيد والفضل
~~بن عميرة وغيره وثقه بن معين وأبو داود
# 4999 ميمون المكي عن بن عباس وعنه عبد الله بن هبيرة مجهول
# 5000 ميمون القناد البصري عن أبي قلابة وعنه خالد الحذاء وسعيد بن أبي
~~عروبة وثقه بن حبان
# 5001 ميناء بن ميناء الزهري مولاهم مولى عبد الرحمن بن عوف عن عثمان رضي
~~الله عنه وعنه همام والد عبد الرزاق قال أبو حاتم منكر الحديث
# | 1 ( حرف النون )
# من اسمه ناجية وناصح ونافع
# 5002 ناجية بن كعب أو بن خفاف الأسدي العنزي عن علي وعمار رضي الله عنهما
~~وعنه أبو إسحاق السبيعي قال أبو حاتم شيخ
# 5003 ناصح بن عبد الله أو بن عبد الرحمن المحلمي الكوفي الحائك عن سماك
~~وعنه علي بن هاشم بن البريد ويعلى الأسلمي PageV07P407
# 5004 ناصح بن العلاء الهاشمي مولاهم البصري عن عمار بن أبي عمار وعبد
~~الرحمن بن سمرة وعنه مسلم بن إبراهيم وبشر بن معاذ وجماعة مختلف فيه وثقه
~~بن المديني وأبو داود وضعفه بن معين
# 5005 نافع بن عبد الله حجازي عن فروة بن قيس وعنه أنس بن عياض مجهول
# 5006 نافع بن عمر بن عبد الله بن جميل الجمحي المكي الحافظ عن بن أبي
~~مليكة وسعيد بن أبي هند وطائفة وعنه بن المبارك وابن مهدي وأبو نعيم وخلق
~~وثقه أبو حاتم وجماعة
# 5007 نافع بن محمود بن الربيع ويقال اسم جده ربيعة الأنصاري المدني
~~القدسي عن عبادة بن الصامت رضي الله عنه وعنه مكحول وثقه بن حبان
# 5008 نافع بن عبد الرحمن بن أبي نعيم القاري امام أهل المدينة عن الأعرج
~~وفاطمة بنت علي ونافع وطائفة وعنه عثمان بن سعيد ورش وعيسى بن ميناء قالون
~~ثبت في القراءة وقد وثقه بن معين ولينه غيره
# 5009 نافع مولى أم سلمة عن مولاته وعنه عبد الرحمن بن الحارث بن ms2596 هشام
# 5010 نافع عن عائشة وعنه الزبير بن عبيد مجهول
# | 1 ( من اسمه نائل ونبيح )
# 5011 نائل بن نجيح الحنفي أو الثقفي أبو سهل البصري أو البغدادي عن فطر
~~بن خليفة وعنه حميد بن مسعدة
# 5012 نبيح بن عبد الله العنزي أبو عمرو الكوفي عن جابر وابن عباس وابن
~~عمر رضي الله عنهم وعنه الأسود بن قيس وجماعة وثقه أبو زرعة PageV07P408
# | 1 ( من اسمه نبيط ونجدة ونجيح )
# 5013 نبيط غير منسوب عن جابان وعنه سالم بن أبي الجعد وثقه بن حبان
# 5014 نجدة بن نفيع الحنفي عن بن عباس وعنه عبد المؤمن بن خالد مجهول
# 5015 نجيح بن عبد الرحمن السندي الهاشمي مولاهم أبو معشر المدني عن بن
~~المسيب ونافع وعنه الليث والثوري وابن مهدي وطائفة
# | 1 ( من اسمه نجي ونذير ونزار )
# 5016 نجي الحضرمي الكوفي عن علي رضي الله عنه وعنه ابنه عبد الله قال بن
~~حبان في الثقات لا يعجبني الاحتجاج بخبره إذا انفرد
# 5017 نذير الضبي عن علي رضي الله عنه وعنه ابنه إياس مجهول
# 5018 نزار بن حيان الأسدي مولى بني هاشم عن أبيه وعنه القاسم بن حبيب
~~التمار
# | 1 ( من اسمه نسي ونصر ونصير )
# 5019 نسي والد عباد الكندي عن عبادة بن الصامت رضي الله عنه وعنه ابنه
~~عبادة مجهول
# 5020 نصر بن حماد بن عجلان البجلي أبو الحارث الوراق البصري الحافظ عن
~~مسعر وشعبة وطائفة وعنه بن رافع ومحمد بن إسحاق الصاغاني وجماعة
# 5021 نصر بن سلام لا يعرف كشيخه عمر بن الهيثم عن عمر بن الهيثم وعنه
~~حمدون بن عمارة مجهول PageV07P409
# 5022 نصر بن أبي ضمرة هو بن محمد بن سليمان بن أبي ضمرة الحمصي عن
~~إسماعيل بن عياش وعنه بن ماجة ضعفه أبو حاتم وثقه بن حبان
# 5023 نصر بن عاصم الأنطاكي عن الوليد بن مسلم ومبشر بن إسماعيل وعنه أبو
~~داود وثقه بن حبان
# 5024 نصر بن عبد الرحمن بن بكار الناجي أبو سليمان الكوفي الوشاء عن عبد
~~الرحمن المحاربي وابن ms2597 إدريس وعنه الترمذي وابن ماجة وثقه النسائي
# 5025 نصر بن عبد الرحمن الكناني شامي عن رجل وعنه ثور بن يزيد مجهول
# 5026 نصر بن القاسم وقيل منصور وقيل نصير عن بن إسحاق وعنه بشر بن ثابت
~~مجهول
# 5027 نصير أو نصير بالفتح أو بصير بالموحدة وقيل بالضاد مولى معاوية أرسل
~~وعنه سليمان بن موسى الدمشقي ومروان بن جناح لا يعرف قلت وثقه بن حبان
# | 1 ( من اسمه النضر والنعمان )
# 5028 النضر بن إسماعيل بن حازم البجلي أبو المغيرة الكوفي القاص امام
~~مسجد الكوفة عن الأعمش وعمر بن ذر وعنه أبو خيثمة وأحمد بن منيع وثقه
~~العجلي
# 5029 النضر بن حماد الفزاري ويقال العتكي أبو عبد الله الكوفي عن سيف
~~التميمي وعنه أبو بكر بن نافع ضعفه أبو حاتم
# 5030 النضر بن زرارة بن عبد الكريم الذهلي أبو الحسن الكوفي نزيل بلخ عن
~~عيسى بن طهمان والثوري وعنه بقية وقتيبة وإبراهيم بن هارون وثقه بن حبان
~~مجهول PageV07P410
# 5031 النضر بن شميل المازني أبو الحسن النحوي البصري الكوفي نزيل مرو عن
~~حميد وبهز بن حكيم وابن عون وشعبة وعنه يحيى بن يحيى وإسحاق الكوسج وثقه
~~النسائي وأبو حاتم وابن معين
# 5032 النضر بن شيبان الحداني البصري عن أبي سلمة وعنه القاسم بن الفضل
# 5033 النضر بن عبد الله الأصم عن إسماعيل بن زكريا وعنه محمد بن علي بن
~~الحسن بن سفيان وثقه بن حبان
# 5034 النضر بن عبد الله السلمي المدني عن عمرو بن حزم وعنه أبو بكر بن
~~حزم مجهول
# 5035 النضر بن عبد الله الأزدي أبو غالب الكوفي نزيل أصبهان عن أبي حنيفة
~~رحمه الله تعالى وعنه عامر بن إبراهيم الأصبهاني فقط
# 5036 النضر بن عبد الرحمن أبو عمر الخزاز الكوفي عن عكرمة وعنه وكيع
# 5037 النضر بن عربي الباهلي مولاهم أبو روح الحراني عن عطاء ومجاهد وعنه
~~الثوري وأبو أسامة وثقه بن معين
# 5038 النضر بن علقمة أبو المغيرة عن داود بن علي وعنه إسحاق بن أبي
~~إسرائيل مجهول ms2598 قلت وقال النسائي ليس بشيء وذكره بن حبان في الثقات
# 5039 النضر بن كثير السعدي أو الضبي أبو سهل البصري العابد عن عبد الله
~~بن محمد بن عقيل وعنه قتيبة والنصر بن علي
# 5040 النضر بن محمد المروزي مولى بني عامر قريش أبو محمد أو أبو عبد الله
~~عن الأعمش وعنه الحسن بن عيسى الماسرجسي وحبان بن موسى وثقه النسائي
~~PageV07P411
# 5041 النضر بن منصور الذهلي أبو عبد الرحمن الكوفي عن أبي الجنوب اليشكري
~~وعنه أبو كريب قال النسائي ليس بثقة
# 5042 النعمان بن راشد الجزري أبو إسحاق الرقي مولى بني أمية عن ميمون بن
~~مهران والزهري وعنه جرير بن حازم وحماد بن زيد
# 5043 النعمان بن سعد بن حبتة الأنصاري الكوفي عن علي رضي الله عنه وعنه
~~بن أخته عبد الرحمن بن إسحاق فقط وثقه بن حبان
# 5044 النعمان بن المنذر الغساني أو اللخمي أبو الوزير الدمشقي عن مجاهد
~~وعطاء وعنه صدقة السمين ويحيى بن حمزة وثقه دحيم وأبو زرعة
# 5045 النعمان بن معبد بن هوذة الأنصاري المدني عن أبيه وعنه ابنه عبد
~~الرحمن وثقه بن حبان
# | 1 ( من اسمه نعيم ونفيع ونقيب )
# 5046 نعيم بن حكيم المدائني عن يزيد بن أبي مريم الثقفي وعنه أبو عوانة
~~والقطان وثقه بن معين العجلي
# 5047 نعيم بن حماد بن معاوية بن الحارث الخزاعي أبو عبد الله المروزي
~~الحافظ نزيل مصر صاحب التصانيف عن أبي حمزة السكري وإبراهيم بن طهمان وابن
~~المبارك وخلق وعنه البخاري تعليقا وابن معين الذهلي وطائفة وثقه أحمد ويحيى
~~العجلي
# 5048 نعيم بن حنظلة ويقال النعمان بن حنظلة ويقال النعمان بن سبرة ويقال
~~بن قبيصة وقلبه بعضهم عن عمار بن ياسر وعنه الدكين بن الربيع وثقه بن حبان
~~والعجلي
# 5049 نعيم بن ربيعة الأزدي عن عمر وعنه مسلم بن يسار الجهني وثقه بن حبان
~~PageV07P412
# 5050 نعيم بن قعنب الرياحي عن أبي ذر رضي الله عنه وعنه يزيد بن عبد الله
~~بن الشخير وثقه بن حبان
# 5051 نعيم بن عبد ms2599 الله بن همام القيني الشامي كاتب عمر بن عبد العزيز عن
~~عمر بن عبد العزيز وعنه رجاء بن أبي سلمة
# 5052 نعيم بن أبي هند النعمان بن أشيم الأشجعي الكوفي عن نبيط بن شريط
~~وأبي وائل وجماعة وعنه الزبير بن الخريت وسليمان التيمي وطائفة وثقه
~~النسائي قال الفلاس مات سنة عشر ومائة
# 5053 نعيم بن يزيد عن علي رضي الله عنه وعنه عمر بن الفضل مجهول
# 5054 نفيع بن الحارث الهمداني أبو داود الكوفي الأعمى القاص ويقال له
~~نافع عن عمران بن حصين وابن عباس رضي الله عنهم وعنه الأعمش وشريك
# 5055 نقيب بموحدة مصغر وقيل آخره دال بن حاجب عن أبي سعيد عن عبد الملك
~~الزبيري وعنه إسماعيل بن محمد الطلحي
# | 1 ( من اسمه نمران ونمير ونميلة )
# 5056 نمران بن جارية بن ظفر عن أبيه وعنه ابنه دلهم وثقه بن حبان
# 5057 نمران بن عتبة الذماري عن أم الدرداء رضي الله عنها وعنه الوليد بن
~~رباح وثقه بن حبان
# 5058 نمير بن عريب الهمداني الكوفي عن عامر بن سعد أو عامر بن مسعود وعنه
~~أبو إسحاق السبيعي وثقه بن حبان
# 5059 نمير بن يزيد القيني الضبي أو الخزرجي عن قحافة بن ربيعة الشامي روى
~~عنه بقية قال الأزدي ليس بشيء وثقه بن حبان PageV07P413
# 5060 نميلة الفزاري عن بن عمر رضي الله عنهما وعنه ابنه عيسى مجهول
# | 1 ( من اسمه النهاس ونهشل ونهيك )
# 5061 النهاس بن قهم القيسي أبو الخطاب البصري عن أنس وعطاء وعنه يزيد بن
~~زريع
# 5062 نهشل بن سعيد بن وردان الورداني البصري سكن خراسان عن الضحاك وعنه
~~عبد الرحمن المحاربي
# 5063 نهيك بن يريم الأوزاعي الشامي عن مغيث الأوزاعي وعنه الأوزاعي
# | 1 ( من اسمه نهار ونوح ونوفل )
# 5064 نهار بن عبد الله العبدي عن أبي سعيد وأبي امامة وعنه أبو طوالة
~~وبدر بن يزيد قال بن خراش مدني صدوق لا يعرف
# 5065 نوح بن حكيم الثقفي المقري عن داود رجل من ولد عروة بن مسعود وعنه ms2600
~~بن إسحاق وثقه بن حبان
# 5066 نوح بن دراج النخعي مولاهم الكوفي أبو محمد القاضي الفقيه قاضي
~~بغداد عن أبي حنيفة رحمه الله تعالى والأعمش وغيره وعنه سعيد بن منصور وعلي
~~بن حجر والطبقة ضعفوه
# 5067 نوح بن ذكوان البصري عن عطاء ويحيى وعنه يحيى بن أبي كثير وثقه بن
~~حبان PageV07P414
# 5068 نوح بن ربيعة الأنصاري مولاهم أبو مكين البصري عن إياس بن الحارث
~~وأبي مجلز وجماعة وعنه يزيد بن زريع القطان وطائفة وثقه يحيى بن معين وأبو
~~داود
# 5069 نوح بن صعصعة المكي عن يزيد بن عامر وعنه سعيد بن السائب وثقه بن
~~حبان له عنده حديث
# 5070 نوح بن قيس بن رباح الأزدي الحداني أبو روح البصري وهو أخو خالد عن
~~أيوب ومحمد بن واسع وجماعة وعنه سعيد بن منصور وقتيبة ونصر بن علي وطائفة
~~وثقه يحيى بن معين
# 5071 نوح بن أبي مريم أبو عصمة المروزي القرشي مولاهم القاضي مشهور
~~بكنيته لكن كذبوه ويعرف بالجامع لجمعه العلوم عن الزهري وثابت وعنه علي بن
~~الحسين بن واقد ونعيم بن حماد
# 5072 نوفل بن عبد الملك بن المغيرة بن نوفل بن الحارث بن عبد المطلب
~~الهاشمي عن أبيه وعنه الربيع بن حبيب
# | 1 ( حرف الهاء )
# من اسمه هارون وهاشم
# 5073 هارون بن سعد العجلي أو الجعفي الكوفي الأعور عن أبي حازم وعنه
~~الحسن بن صالح
# 5074 هارون بن سعد صاحب راية علي كوفي مجهول روى عن علي
# 5075 هارون بن صالح الهمداني الكوفي عن أبي هند الحرث بن عبد الرحمن
~~الهمداني وعنه محمد بن الحسن بن الزبير الأسدي وثقه بن حبان PageV07P415
# 5076 هارون بن عنترة بن عبد الرحمن الشيباني أبو عبد الرحمن أو أبو عمرو
~~بن أبي وكيع الكوفي عن سعيد بن جبير وعنه الثوري ويعقوب القمي وثقه أحمد
~~ويحيى بن معين
# 5077 هارون بن أبي عيسى الشامي عن إسماعيل بن أبي خالد وعنه معلى بن أسد
~~وثقه بن حبان
# 5078 هارون بن مسلم بن هرمز العجلي صاحب الحناء ms2601 أبو الحسين البصري عن
~~قتادة وعنه أبو داود الطيالسي وغيره قال أبو حاتم مجهول
# 5079 هارون بن المغيرة بن حكيم البجلي بفتح الموحدة والجيم أبو حمزة
~~المروزي أو الرازي عن عبيد الله بن عمر وحجاج بن أرطاة وعنه يحيى بن معين
~~ومحمد بن عمر زنيج وثقه النسائي
# 5080 هارون بن هارون بن عبد الله بن محرز أو محيريز التميمي أبو محرز
~~المدني القرشي عن الأعرج وعنه محمد بن شعيب بن شابور
# 5081 هارون أبو محمد البربري مولى آل المغيرة قيل اسم أبيه إبراهيم وقيل
~~ميمون عن عطاء وعنه أبو نعيم
# 5082 هارون بن أم هانئ وقيل انه حفيدها عن أم هانئ وعنه سماك مجهول
# 5083 هاشم بن البريد أبو علي الكوفي عن أبي إسحاق ومسلم البطين وعنه ابنه
~~علي وسلم بن قتيبة وثقه بن معين
# 5084 هاشم بن سعيد أبو إسحاق الكوفي ثم البصري عن زيد بن عطية وعنه عبد
~~الصمد بن عبد الوارث وثقه بن حبان وقال بن معين ليس بشيء
# 5085 هاشم بن القاسم بن شيبة الحراني مولى قريش أبو محمد أو أبو يحيى عن
~~يعلى بن الأشدق وابن وهب وعنه بن ماجة ذكره بن حبان في الثقات PageV07P416
# | 1 ( من اسمه هانئ وهبيرة وهدبة )
# 5086 هانئ بن أيوب الحنفي الكوفي عن الشعبي وعنه حسين الجعفي وغيره وثقه
~~بن حبان
# 5087 هانئ بن عبد الله بن الشخير أخو يزيد عن أبيه وعنه أبو بشر جعفر
# 5088 هانئ بن هانئ الهمداني الكوفي عن علي رضي الله عنه وعنه أبو إسحاق
# 5089 هانئ مولى علي عن مولاه علي وعنه عبد الرحمن بن يعقوب الجهني مولى
~~الحرقة لا يعرف وثقه بن حبان
# 5090 هبيرة بن يريم وزن عظيم الشيباني بمعجمة ثم موحدة خفيفة ويقال
~~الخارفي بمعجمة وخاء أبو الحارث الكوفي عن علي رضي الله عنه وعنه أبو إسحاق
~~السبيعي وثقه بن حبان
# 5091 هدبة بن خالد بن الأسود القيسي أبو خالد البصري ويقال له الهذب
~~الحافظ ويقال هداب عن همام بن يحيى ms2602 وحماد بن سلمة وجرير بن حازم وخلق وعنه
~~البخاري ومسلم وأبو داود وثقه يحيى بن معين وابن حبان
# | 1 ( من اسمه الهذيل وهرماس وهشام )
# 5092 الهذيل بن الحكم الأزدي المسعودي أبو المنذر البصري عن الحكم بن بن
~~أبان وعنه معلى بن أسد قال البخاري منكر الحديث
# 5093 الهرماس بن حبيب التميمي العنبري قال أبو حاتم شيخ أعرابي عن أبيه
~~عن جده وعنه النضر بن شميل فقط قال أبو حاتم شيخ
# 5094 هشام بن حجير بمهملة وجيم مصغر المكي عن طاوس وعنه بن جريج وشبل بن
~~عباد وثقه العجلي PageV07P417
# 5095 هشام بن حسان الأزدي مولاهم القردوسي بالقاف وضم الدال أبو عبد الله
~~البصري أحد الاعلام عن حفصة بنت سيرين ومحمد وأنس ابني سيرين وطائفة وعنه
~~السفيانان والحمادان ضعفه القطان عن عطاء
# 5096 هشام بن خالد بن زيد بن مروان الأزرق أبو مروان الدمشقي عن الوليد
~~بن مسلم وجماعة وعنه أبو داود وابن ماجة قال أبو حاتم صدوق
# 5097 هشام بن زياد بن أبي يزيد وهو هشام بن أبي هشام الأموي أبو المقدام
~~ويقال له أيضا هشام بن أبي الوليد البصري المدني عن أبي صالح السمان وعنه
~~آدم بن أبي إياس ومسلم بن إبراهيم
# 5098 هشام بن سعد أبو عباد أو أبو سعد القرشي مولاهم المدني يتيم زيد بن
~~اسلم روى عنه فأكثر وعن نافع وعنه الليث وابن مهدي
# 5099 هشام بن سعيد الطالقاني أبو أحمد البزاز نزيل بغداد عن معاوية بن
~~سلام وابن لهيعة وعنه محمد بن رافع وأحمد ووثقه بن سعد أيضا
# 5100 هشام بن سليمان بن عكرمة بن خالد المخزومي المكي عن هشام بن عروة
~~وعنه أحمد بن محمد الأزرق ومحمد بن يحيى العدني
# 5101 هشام بن أبي عبد الله سنبر أبو بكر البصري الدستوائي عن قتادة ويحيى
~~بن أبي كثير وطائفة وعنه ابنه معاذ وأبو داود الطيالسي وأبو نعيم ومسلم بن
~~إبراهيم وخلق قال العجلي ثقة ثبت وقال بن سعد حجة
# 5102 هشام بن عبد الملك بن عمران ms2603 أبو التقى اليزني الحمصي عن إسماعيل بن
~~عياش ومحمد بن حرب ويحيى بن سعيد العطار الحمصي وطائفة وعنه أبو داود
~~والنسائي وابن ماجة وقال أبو حاتم متقن وقال النسائي ثقة PageV07P418
# 5103 هشام بن عروة بن الزبير بن العوام الأسدي أبو المنذر أحد الاعلام عن
~~أبيه وزوجته فاطمة بنت المنذر وأبي سلمة بن عبد الرحمن وخلق وعنه أيوب وابن
~~جريج وشعبة ومعمر وخلق
# 5104 هشام بن عمار بن نصير السلمي أبو الوليد الدمشقي الحافظ الخطيب صدوق
~~مقري عن مالك والجراح بن مليح ويحيى بن حمزة وخلق وعنه البخاري وأبو داود
~~والنسائي وابن ماجة ويحيى بن معين ووثقه وكذا وثقه العجلي
# 5105 هشام بن عمرو الفزاري عن عبد الرحمن بن الحارث وعنه أبو سلمة حماد
~~بن سلمة فقط وثقه أبو حاتم وجماعة
# 5106 هشام بن هارون الأنصاري المدني عن معاذ بن رفاعة وعنه زيد بن الحباب
~~وثقه بن حبان لا يعرف
# 5107 هشام بن أبي الوليد كأنه أبو المقدام عن أبيه وعنه أبو الوليد
~~الطيالسي هو بن زياد
# | 1 ( من اسمه هشيم وهمام وهود وهوذة )
# 5108 هشيم بن بشير بن القاسم بن دينار السلمي أبو معاوية بن خازم الواسطي
~~الحافظ نزيل بغداد عن الزهري وعمرو بن دينار ومغيرة بن مقسم وخلق وعنه شعبة
~~والثوري وأحمد وعلي بن المثنى الموصلي وابن معين وخلق PageV07P419
# 5109 همام بن يحيى بن دينار العوذي بفتح المهملة وسكون الواو وكسر
~~المعجمة الأزدي أبو عبد الله أو أبو بكر البصري أحد الأئمة عن الحسن وعطاء
~~ونافع ويحيى بن أبي كثير وعنه الثوري وابن المبارك وابن مهدي
# 5110 هود بن عبد الله بن سعد العبدي القصري عن جده لأمه مزيدة بوزن كبيرة
~~بن جابر وعنه طالب بن حجير
# 5111 هوذة بن خليفة بن عبد الله بن عبد الرحمن بن أبي بكرة الثقفي
~~البكراوي أبو الأشهب البصري الأصم نزيل بغداد عن سليمان التيمي وابن جريج
~~وعنه أبو بكر بن أبي شيبة وعباس بن محمد
# | 1 ( من اسمه هلال )
# 5112 هلال بن ms2604 أسامة الفرسي المدني وقيل بن أبي هلال بن علي بن أسامة
~~العامري مولاهم المدني عن أنس وعطاء بن يسار وعنه سعيد بن أبي هلال ومالك
~~وفليح
# 5113 هلال بن علي بن أسامة الفهري عن بن عمر رضي الله عنهما وعنه أسامة
~~بن زيد الليثي وحده
# 5114 هلال بن سام رأى أنسا روى عن أنس وعنه بشر بن الحكم لا يعرف قلت هذا
~~خطاء وانما هو هياج
# 5115 هلال بن جبير ويقال بن جبير بلا تصغير بصري عن أنس وعنه يونس بن
~~فروة وثقه بن حبان
# 5116 هلال بن جبير آخر كوفي عن سعيد بن جبير وعنه مسعر قال أبو حاتم لا
~~اعرفه ووثقه بن حبان PageV07P420
# 5117 هلال بن خباب العبدي مولاهم أبو العلاء البصري نزيل المدائن عن يحيى
~~بن جعدة ومجاهد وعنه مسعر وابن عون أو أبو عوانة وثقه أحمد بن معين وجماعة
# 5118 هلال بن رواد الطائي أو الكناني الشامي الكاتب عن الزهري وعنه ابنه
~~حماد
# 5119 هلال بن زيد بن يسار بن بولا مولى النبي صلى الله عليه وسلم أبو
~~عقال البصري نزيل عسقلان عن أنس وعنه إبراهيم بن سويد
# 5120 هلال بن أبي زينب فيروز القرشي مولاهم البصري عن شهر وعنه بن عون
~~وثقه بن حبان
# 5121 هلال بن عامر أو عمرو بصري عن قبيصة بن مخارق وعنه أبو قلابة
# 5122 هلال بن عبد الله الباهلي مولاهم أبو هاشم البصري عن أبي إسحاق
~~والحارث الأعور وعنه عفان
# 5123 هلال بن العلاء بن هلال بن عمر الباهلي مولاهم أبو عمر الرقي عن
~~أبيه وحجاج بن محمد ومعلى بن أسد وخلق وعنه النسائي
# 5124 هلال بن فياض لقبه شاذ في الشين المعجمة
# 5125 هلال بن أبي هلال أو بن أبي مالك الأزدي وهو بن ميمون وقيل غير ذلك
~~في اسم أبيه أبو ظلال بمعجمة القسملي بفتح القاف وسكون المهملة البصري
~~الأعمى عن أنس وعنه حماد بن سلمة وجعفر بن سليمان
# 5126 هلال بن أبي هلال المدني عن أبي هريرة ms2605 وعنه ابنه محمد وثقه بن حبان
~~PageV07P421
# | 1 ( من اسمه هياج )
# 5127 هياج بن بسام القيسي عن أنس وعنه بشر بن الحكم تقدم في هلال
# 5128 هياج بن بسطام التميمي البرجمي بجيم أبو خالد الخراساني الهروي عن
~~حميد الطويل وخالد الحذاء وعنه داود بن المحبر ضعفه بن معين
# 5129 هياج بن عمران بن الفصيل التميمي البصري عن سمرة بن جندب رضي الله
~~عنه وعنه الحسن البصري وثقه بن سعد
# | 1 ( من اسمه الهيثم )
# 5130 الهيثم بن جميل البغدادي أبو سهل الحافظ نزيل أنطاكية عن جرير بن
~~حازم وحماد بن سلمة وطائفة وعنه أحمد وابن المثنى وثقه الدارقطني
# 5131 الهيثم بن حميد الدمشقي الغساني مولاهم أبو أحمد أو أبو الحارث عن
~~يحيى بن الحارث الذماري وثور بن يزيد وعنه الوليد بن مسلم ومعلى بن منصور
~~وعلي بن حجر قال أبو داود قدري ثقة ووثقه بن معين ودحيم
# 5132 الهيثم بن حبيب الصيرفي الكوفي شيخ لمحمد بن زريق الطبراني عن الحكم
~~وعكرمة وعنه شعبة وأبو حنيفة وثقه بن معين وأبو زرعة وأبو حاتم
# 5133 الهيثم بن خالد ويقال بن جنان أو جناد بضم الجيم الجهني أبو الحسن
~~الكوفي عن وكيع وعنه أبو داود ووثقه
# 5134 الهيثم بن خالد بن يزيد المصيصي نزيل بغداد مولى عثمان عن حجاج
~~وغيره وعنه المحاملي ضعفه الدارقطني
# 5135 الهيثم بن خالد البجلي الكوفي الخشاب عن مالك بخبر منكر وعنه أحمد
~~بن محمد البغدادي الساجي شيخ زكريا PageV07P422
# 5136 الهيثم بن رافع الطاطري الحنفي أو الباهلي أبو يحيى أو أبو الحكم أو
~~أبو الحارث وقيل هم ثلاثة عن عطاء وعنه يزيد بن هارون
# 5137 الهيثم بن الربيع العقيلي أبو المثنى البصري أو الواسطي عن قرة بن
~~خالد وعنه نصر بن علي
# 5138 الهيثم بن شفي الرعيني أبو الحصين الحجري المصري عن فضالة بن عبيد
~~وعبد الله بن عمرو وعنه أبو الخير اليزني ويزيد بن أبي حبيب
# | 1 ( حرف الواو )
# من اسمه واصل وواقد ووائل
# 5139 واصل بن أبي جميل الشامي ms2606 أبو بكر السلاماني عن مجاهد ومكحول وعنه
~~الأوزاعي وغيره قال بن معين لا شيء
# 5140 واصل بن عبد الرحمن أبو حرة البصري عن الحسن وابن سيرين وعنه حماد
~~بن سلمة ويحيى القطان وثقه شعبة وأحمد
# 5141 واصل بن السائب الرقاشي أبو يحيى البصري عن عطاء وعنه عيسى بن يونس
~~ومحمد بن عبيد قال البخاري منكر الحديث
# 5142 واقد بن عبد الرحمن بن سعد بن معاذ الأنصاري ان كان واقد بن عمرو بن
~~سعد بن معاذ الأشهلي فهو ثقة عن جابر وعنه داود بن الحصين وثقه بن حبان
# 5143 واقد بن أبي واقد الليثي عن أبيه وعنه زيد بن اسلم
# 5144 وائل بن علقمة عن وائل بن حجر وعنه عبد الجبار بن وائل صوابه عن عبد
~~الجبار بن وائل عن أخيه علقمة بن وائل عن صلاة أبيه PageV07P423
# 5145 وائل بن مهانة بنون التيمي الكوفي عن بن مسعود رضي الله عنه وعنه ذر
~~الهمداني وثقه بن حبان
# | 1 ( من اسمه وحشي وورقاء )
# 5146 وحشي بن حرب بن وحشي بن حرب الحمصي أو الحبشي عن أبيه عن جده وعنه
~~الوليد بن مسلم
# 5147 ورقاء بن عمر اليشكري أبو بشر أو أبو يونس الكوفي نزيل المدائن عن
~~عمرو بن دينار وابن المنكدر وجماعة وعنه شعبة ويحيى بن آدم وطائفة وثقه
~~أحمد وابن معين وقال أبو داود سنة الا ان فيه إرجاء
# | 1 ( من اسمه وزير ووبر والوضين )
# 5148 وزير بن صبيح بالفتح الثقفي أبو روح الشامي عن يونس بن ميسرة وعنه
~~صفوان بن صالح
# 5149 وزير بن صبيح الوزان بصري مجهول لا يعرف وخبره منكر
# 5150 الوضين بن عطاء بن كنانة أبو عبد الله أو أبو كنانة الشامي الخزاعي
~~الدمشقي عن خالد بن معدان ومحفوظ بن علقمة وعنه الحمادان وثقه أحمد وابن
~~معين ودحيم وضعفه بن سعد والجوزجاني
# | 1 ( من اسمه وعلة ووقاء ووكيع )
# 5151 وعلة بن عبد الرحمن بن وثاب اليماني عن عبد الرحمن بن علي وعنه عمر
~~بن جابر اليمامي وثقه بن ms2607 حبان
# 5152 وقاء بقاف وأوله مكسورة بن إياس الأسدي الوالبي أبو يزيد الكوفي عن
~~علي بن ربيعة وعنه الثوري والقطان وقال لم يكن بالقوي PageV07P424
# 5153 وكيع بن عدس أو حدس على وزنه الا انه بحاء مهملة أبو مصعب العقيلي
~~الطائفي عن عمه أبي رزين وعنه يعلى بن عطاء فقط وثقه بن حبان
# 5154 وكيع بن محرز بن وكيع الناجي بنون البصري عن زيد العمي وعنه بن
~~المديني ومحمد بن أبي بكر المقدمي قال أبو حاتم لا بأس به
# | 1 ( من اسمه الوليد ووهب )
# 5155 الوليد بن بكير التميمي أو الطهوي أبو جناب الكوفي عن الأعمش وعنه
~~محمد بن نمير وثقه بن حبان قال أبو حاتم شيخ
# 5156 الوليد بن أبي ثور هو بن عبد الله بن أبي ثور الهمداني المرهبي
~~الكوفي
# 5157 الوليد بن جميع وهو بن عبد الله بن جميع
# 5158 الوليد بن دينار السعدي أبو الفضل البصري التياس عن الحسن وعنه حماد
~~بن زيد والفضل بن موسى وعدة وثقه بن حبان وضعفه بن معين
# 5159 الوليد بن زوران السلمي الرقي عن أنس وعنه جعفر بن برقان وثقه بن
~~حبان
# 5160 الوليد بن زياد الهمداني والصواب بن يزيد الهدادي عن زيد بن زائد
~~ويقال زائدة وعنه إسماعيل السدي
# 5161 الوليد بن سفيان بن أبي مريم الغساني الشامي الحمصي عن يزيد بن قطيب
~~وعنه أبو بكر بن أبي مريم وثقه بن حبان
# 5162 الوليد بن سفيان عن علي وعنه يحيى بن أبي عمرو السامي مجهول
~~PageV07P425
# 5163 الوليد بن سليمان بن أبي السائب القرشي مولاهم أبو العباس الدمشقي
~~عن رجاء بن حيوة ونافع وعنه ابنه عبد العزيز والوليد بن مسلم وثقه أبو حاتم
~~وأبو داود ودحيم والعجلي
# 5164 الوليد بن شجاع بن الوليد بن قيس أبو همام السكوني بن أبي بدر
~~الكوفي نزيل بغداد عن شريك وهشيم وعلي بن مسهر وخلق وعنه مسلم وأبو داود
~~والترمذي وابن ماجة وخلق
# 5165 الوليد بن عبد الله بن جميع الزهري المكي نزيل الكوفة عن ms2608 أبي الطفيل
~~وأبي سلمة بن عبد الرحمن وعنه وكيع وابن فضيل وثقه بن معين والعجلي
# 5166 الوليد بن عبد الله بن أبي ثور المرهبي الهمداني الكوفي عن زياد بن
~~علاقة وسماك وعنه محمد بن الصباح الدولابي ولوين
# 5167 الوليد بن عبدة بفتحات مولى عبد الله بن عمرو بن العاص عن مولاه
~~وعنه يزيد بن أبي حبيب وثقه بن حبان
# 5168 الوليد بن عقبة عن معاوية بن صالح مجهول
# 5169 الوليد بن عطاء بن خباب بمعجمة وموحدتين الحجازي عن الحارث بن عبد
~~الله وعنه بن جريج وثقه بن حبان
# 5170 الوليد بن عقبة بن نزار العنسي بنون عن حذيفة بن أبي حذيفة وعنه زيد
~~بن الحباب مجهول
# 5171 الوليد بن القاسم بن الوليد الهمداني الخبذعي الكوفي عن الأعمش
~~والاحوص بن حكيم وعنه يعقوب الدورقي والحسين بن علي الصدائي وثقه أحمد وابن
~~حبان وابن عدي PageV07P426
# 5172 الوليد بن كامل بن معاذ البجلي مولاهم أبو عبيدة بالضم الشامي عن
~~رجاء بن حيوة وعنه يحيى بن حمزة وثقه بن حبان
# 5173 الوليد بن كثير القرشي مولاهم أبو محمد المخزومي المدني ثم الكوفي
~~صدوق عارف بالمغازي عن بشير بن يسار والأعرج وجماعة وعنه إبراهيم بن سعد
~~وأبو أسامة والواقدي وطائفة وثقه بن معين وأبو داود
# 5174 الوليد بن محمد الموقري الأموي مولاهم أبو بشير أو أبو بشر البلقاوي
~~مولى بني أمية عن الزهري وعطاء الخراساني وعنه سليمان بن عبد الرحمن وعلي
~~بن حجر
# 5175 الوليد بن مسلم القرشي مولاهم الأموي أبو العباس الدمشقي عالم الشام
~~عن بن عجلان وهشام بن حسان وثور بن يزيد والأوزاعي وخلق وعنه أحمد وإسحاق
~~وابن المديني وأبو خيثمة وخلق
# 5176 الوليد بن المغيرة المخزومي المكي عن بن المسيب وعنه الثوري مجهول
# 5177 الوليد بن نافع عن شعبة وعنه أبو داود الحراني
# 5178 الوليد بن يزيد الهدادي أبو هاشم البصري عن عبد الملك بن كردوس وعنه
~~قتيبة ونصر بن علي وغيره تكلم فيه PageV07P427
# | 1 ( من اسمه وهب )
# 5179 وهب بن جابر ms2609 الخيواني الهمداني الكوفي عن عبد الله بن عمرو وعنه أبو
~~إسحاق فقط وثقه يحيى بن معين والعجلي
# 5180 وهب بن جرير بن حازم بن زيد أبو عبد الله أو أبو العباس الأزدي
~~البصري الحافظ عن أبيه وابن عون وشعبة وخلق وعنه أحمد وإسحاق وابن معين
~~ووثقه
# 5181 وهب بن ربيعة الكوفي عن بن مسعود رضي الله عنه وعنه عمارة بن عمير
~~وثقه بن حبان
# 5182 وهب بن منبه بن كامل اليماني أبو عبد الله الأبناوي الصنعاني
~~الاخباري عن بن عباس وجابر وأبي سعيد وطائفة وعنه سماك بن الفضل وهمام بن
~~نافع وخلق وثقه النسائي
# 5183 وهب مولى أبي أحمد بن جحش عن أم سلمة رضي الله عنها وعنه حبيب بن
~~أبي ثابت فقط وثقه بن حبان
# | 1 ( حرف اللام ألف )
# 5184 لاحق بن حميد بن سعيد السدوسي البصري أبو مجلز عن جندب وابن مسعود
~~وابن عباس وعنه أنس بن سيرين وحبيب بن الشهيد وعاصم الأحول وطائفة وثقه أبو
~~زرعة والعجلي وابن سعد وابن خراش PageV07P428
# | 1 ( حرف الياء )
# من اسمه ياسين ويحيى
# 5185 ياسين بن شيبان أو بن سنان العجلي الكوفي عن إبراهيم بن محمد بن علي
~~وعنه وكيع
# 5186 يحيى بن إسحاق الهنائي ويقال يزيد بن أبي إسحاق ويقال يزيد بن أبي
~~يحيى عن أنس رضي الله عنه وعنه عبيدة بن حميد
# 5187 يحيى بن إسحاق أو بن أبي إسحاق عن عمه رافع بن خديج وعنه يحيى يحيى
~~بن أبي كثير وثقه يحيى بن معين
# 5188 يحيى بن أبي إسحاق الحضرمي مولاهم البصري النحوي عن أنس وسليمان بن
~~يسار وسالم وعنه شعبة والثوري ووهيب بن خالد وثقه النسائي
# 5189 يحيى بن إسماعيل الواسطي أبو زكريا عن إبراهيم بن سعد وابن المبارك
~~وعنه أبو داود وغيره
# 5190 يحيى بن أكثم بن محمد بن قطن التميمي المروزي أبو محمد الخراساني ثم
~~البغدادي القاضي المشهور فقيه صدوق عن جرير بن عبد الحميد والفضل بن موسى
~~وعيسى بن يونس وعنه الترمذي وغيره تكلم فيه ms2610 بن معين وأبو حاتم وإسحاق لأنه
~~سمع من بن المبارك وهو صغير وعظمه أحمد
# 5191 يحيى بن أيوب بن أبي زرعة بن عمرو بن جرير البجلي الكوفي عن جده
~~وعنه أبو أسامة وأبو أحمد الزبيري وثقه أبو داود PageV07P429
# 5192 يحيى بن أيوب الغافقي بمعجمة ثم فاء بعد الألف ثم قاف أبو العباس
~~المصري أحد العلماء عن جعفر بن ربيعة وبكير بن الأشج وطائفة وعنه الليث
~~وابن وهب وثقه يحيى بن معين ويعقوب بن سفيان
# 5193 يحيى بن بشير بن خلاد الأنصاري المدني عن أمه وعنه إبراهيم بن
~~المنذر الحزامي وابن أبي فديك
# 5194 يحيى بن الجزار العرني الكوفي مولى نخيلة عن علي وعائشة رضي الله
~~عنهما وعنه عمرو بن مرة والحكم بن عتيبة وثقه أبو حاتم
# 5195 يحيى بن أبي الحجاج المنقري الاهتمي أبو أيوب البصري واسم أبيه عبد
~~الله عن الجريري وحاتم بن أبي صغيرة وعنه إسحاق بن راهويه ومحمد بن يحيى
~~وثقه بن حبان
# 5196 يحيى بن حرب المدني عن المقبري وعنه موسى بن عبيدة مجهول
# 5197 يحيى بن الحسن بن عثمان بن عبد الرحمن بن عوف أبو إبراهيم الزهري
~~المدني عن أشعث بن إسحاق وعنه موسى بن يعقوب الزمعي وثقه بن حبان
# 5198 يحيى بن حكيم بن صفوان بن أمية الجمحي المكي عن عبد الله بن عمرو
~~وعنه بن أبي مليكة وثقه بن حبان
# 5199 يحيى بن حمزة بن واقد الحضرمي أبو عبد الرحمن البتلهي قاضي دمشق عن
~~أبيه ونصر بن علقمة والأوزاعي وخلق وعنه الوليد بن مسلم وأبو مسهر ومروان
~~بن محمد وخلق وثقه بن معين ودحيم وأبو داود النسائي وغيرهم PageV07P430
# 5200 يحيى بن أبي حية الكلبي أبو جناب الكوفي عن عبد الرحمن بن أبي ليلى
~~وطاوس وعنه جرير بن عبد الحميد ووكيع
# 5201 يحيى بن خدام بكسر المعجمة بن منصور الغبري أبو زكريا البصري السقطي
~~عن صفوان بن عيسى ومحمد بن عبد الله الأنصاري هو بن المثنى وعنه بن ماجة
~~وثقه بن حبان
# 5202 يحيى ms2611 بن راشد المازني أبو سعيد البراء بموحدة وراء مشددة ومد البصري
~~عن حميد وعنه نعيم بن حماد ضعفه أبو حاتم
# 5203 يحيى بن زكريا أبي زائدة الهمداني أبو سعيد الكوفي الحافظ عن أبيه
~~وعاصم الأحول وداود بن أبي هند وخلق وعنه أحمد ويحيى بن معين وابن المديني
~~وأحمد بن منيع وخلق وثقه العجلي والنسائي
# 5204 يحيى بن أبي زكريا الغساني أبو مروان الواسطي الحمصي عن هشام بن
~~عروة وأيوب بن حوط وحماد بن زيد وغيرهما وعنه محمد بن حرب النشائي وإسحاق
~~راهويه ونعيم بن حماد والهيثم بن خارجة وجماعة تركوه
# 5205 يحيى بن سلمة بن كهيل بالتصغير الحضرمي أبو جعفر الكوفي عن أبيه
~~وعنه ابنه إسماعيل ضعفه يحيى بن معين وكان شيعيا
# 5206 يحيى بن سليمان بن يحيى بن سعيد الجعفي أبو سعيد الكوفي المقري نزيل
~~مصر عن الدراوردي والمحاربي وابن وهب وعنه البخاري وأحمد بن الحسن الترمذي
~~وثقه بن حبان
# 5207 يحيى بن أبي سليمان المدني أبو صالح عن سعيد المقبري وعنه شعبة
~~PageV07P431
# 5208 يحيى بن سليم الطائفي أبو محمد القرشي مولاهم المكي الخراز بمعجمة
~~ثم مهملة نزيل مكة عن إسماعيل بن أمية وإسماعيل بن كثير وابن جريج وعبد
~~الله بن عثمان بن خثيم وعنه أحمد وإسحاق وقتيبة وثقه بن معين وابن سعد
~~والنسائي الا في عبيد الله بن عمرو
# 5209 يحيى بن سليمان أبو بلج الفزاري عن عمرو بن ميمون وعنه شعبة وهشيم
~~وثقه بن معين والنسائي والدارقطني
# 5210 يحيى بن سليم الهاشمي مولى النبي صلى الله عليه وسلم عن عبيد الله
~~بن عبد الله بن عمر وعنه الليث بن سعد وثقه النسائي
# 5211 يحيى بن سيرين الأنصاري أبو عمرو البصري مولى أنس أخو محمد سمع أنسا
~~مولاه وعنه اخوه محمد وأخته حفصة لينه بن معين ووثقه بن حبان مات قبل أخيه
~~محمد
# 5212 يحيى بن شبل البلخي عن مقاتل بن سليمان وعنه مكي بن إبراهيم لا يعرف
# 5213 يحيى بن صالح الوحاظي بضم الواو وتخفيف المهملة أبو ms2612 زكريا الحمصي
~~أحد كبار المحدثين والفقهاء عن سعيد بن عبد العزيز وفليح بن سليمان ومعاوية
~~بن سلام وطائفة وعنه البخاري وأحمد بن صالح ومحمد بن يحيى قال أبو زرعة
~~الدمشقي عن بن معين ثقة PageV07P432
# 5214 يحيى بن أبي صالح المدني وقيل ان أباه أبو صالح السمان عن أبي هريرة
~~رضي الله عنه وعنه الخليل بن مرة وثقه بن حبان
# 5215 يحيى بن الضريس بمعجمة ثم مهملة مصغرا البجلي مولاهم أبو زكريا
~~الرازي القاضي عن عكرمة بن عمار والثوري وعنه جرير بن عبد الحميد وإسحاق بن
~~موسى وثقه بن معين
# 5216 يحيى بن طلحة بن أبي كثير اليربوعي أبو زكريا الكوفي عن قيس بن
~~الربيع وأبي الأحوص وعنه الترمذي وثقه بن حبان
# 5217 يحيى بن عباد الضبعي بضم المعجمة وفتح الموحدة بعدها مهملة أبو عباد
~~البصري نزيل بغداد عن الحمادين وعنه أحمد والحسن الزعفراني
# 5218 يحيى بن عباد السعدي عن بن جريج وعنه داود بن شبيب مجهول
# 5219 يحيى بن عبد الله بن بحير بفتح الموحدة وكسر المهملة المرادي التيمي
~~القاص عن رجل وعنه معتمر وثقه بن حبان
# 5220 يحيى بن عبد الله بن الأدرع عن أبي الطفيل وعنه جعفر بن ربيعة فقط
~~قلت وثقه بن حبان
# 5221 يحيى بن عبد الله بن عبيد الله بن أبي مليكة التيمي القرشي المكي عن
~~أبيه وعنه يحيى بن عثمان التيمي مولى أبي بكر وثقه بن حبان وقال يعتبر
~~بحديثه
# 5222 يحيى بن عبد الله بن مالك بن عياض الدارمي المعروف جده بمالك الدار
~~مولى عمر عن خبيب بن عبد الله بن الزبير وعنه محمد بن عجلان قال أبو حاتم
~~شيخ وثقه بن حبان PageV07P433
# 5223 يحيى بن عبد الله بن الضحاك بن ثابت الأموي مولاهم البابلتي أبو
~~سعيد الحراني بن امرأة الأوزاعي عن صفوان بن عمرو وعنه سلمة بن شبيب ومحمد
~~بن يحيى الحراني فيه لين
# 5224 يحيى بن عبد الله بن بكير المخزومي مولاهم أبو زكريا المصري الحافظ
~~وقد ينسب إلى جده عن ms2613 مالك والليث وبكر بن مضر وخلق وعنه البخاري وحرملة بن
~~يحيى وأبو زرعة وطائفة
# 5225 يحيى بن عبد الحميد بن عبد الرحمن بن ميمون بشمين بفتح الموحدة
~~وسكون المعجمة الحماني بكسر المهملة وتشديد الميم الحافظ أبو زكريا الكوفي
~~عن أبيه وعبد الرحمن الغسيل وعنه أبو حاتم وموسى بن هارون صاحب المسند وثقه
~~أحمد وضعفه الجمهور يقال ان مسلما روى له لفظه في إسناد حديث
# 5226 يحيى بن عبد الرحمن بن مالك الارحبي ارحب بطن من همدان الكوفي عن
~~المطلب بن زياد وعنه أبو كريب وجماعة
# 5227 يحيى بن عبد الرحمن الثقفي عن عون بن عبد الله وعنه سعيد بن أبي
~~هلال وحده وثقه بن حبان
# 5228 يحيى بن عبد الرحمن العصري البصري من عبد القيس عن ابن شهاب وعنه
~~أبو سلمة موسى بن إسماعيل وثقه ابن حبان لا يعرف
# 5230 يحيى بن عبد الملك بن حميد بن أبي غنية الخزاعي الكوفي أصله من
~~أصبهان أبو زكريا الكوفي عن هشام بن عروة والأعمش وعنه أحمد وابن معين وابن
~~المديني وثقه أحمد وأبو داود PageV07P434
# 5231 يحيى بن عبيد الله بن موهب بفتح الميم والهاء بينهما واو ساكنة
